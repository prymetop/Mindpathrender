{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mindpath-v2",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mindpath",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
